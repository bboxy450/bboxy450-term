def compact_schema(source, reference):
    definitions = {}
    pending = [reference.removeprefix("#/$defs/")]
    def references(value):
        if isinstance(value, dict):
            ref = value.get("$ref", "")
            if ref.startswith("#/$defs/"):
                pending.append(ref.removeprefix("#/$defs/"))
            for child in value.values(): references(child)
        elif isinstance(value, list):
            for child in value: references(child)
    while pending:
        name = pending.pop()
        if name in definitions: continue
        definitions[name] = source["$defs"][name]
        references(definitions[name])
    return {"$schema":source["$schema"],"$defs":definitions,"$ref":reference}
