{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bboxy450:transport:1.0",
  "title": "bboxy450 transport 1.0",
  "$defs": {
    "WrapRequest": {
      "type": "object",
      "required": [
        "fields",
        "command"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        }
      },
      "additionalProperties": true
    },
    "WrapResult": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*$"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "x-methods": {
    "wrap": {
      "request": "#/$defs/WrapRequest",
      "result": "#/$defs/WrapResult"
    }
  }
}
