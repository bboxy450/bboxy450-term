{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bboxy450:plugin:shape:1.0",
  "title": "bboxy450 plugin shape 1.0",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "icon": {
      "type": ["string", "null"],
      "maxLength": 4096
    },
    "identity": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "signed_writer": { "type": "boolean" },
    "fixture_bootstrap": { "type": "boolean" },
    "shape_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "contract_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": [
                    "object",
                    "boolean"
                  ]
                },
                "result": {
                  "type": [
                    "object",
                    "boolean"
                  ]
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "name",
                "args",
                "result",
                "timeout_ms"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "contract",
          "contract_version",
          "commands"
        ],
        "additionalProperties": true
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 16,
      "$comment": "Optional metadata envelope, not an Agent Skills parser or upstream MCP skills wire. The SDK additionally enforces UTF-8 byte and whole serialized-array bounds.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "\\S",
            "not": { "pattern": "\u0000" }
          }
        },
        "required": ["name", "description", "content"],
        "additionalProperties": true
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "enum": [
              "before",
              "after"
            ]
          },
          "budget_ms": {
            "type": "integer",
            "minimum": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "$comment": "Only for event \"bus\": a subject pattern (`*` one token, `>` the tail) whose first token is a public namespace, never inbox or plugin. Delivered after publication."
          }
        },
        "required": [
          "event",
          "phase",
          "budget_ms"
        ],
        "additionalProperties": true
      }
    },
    "auth": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "status_command": {
              "type": "string",
              "minLength": 1
            },
            "login_command": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status_command",
            "login_command"
          ],
          "additionalProperties": true
        }
      ]
    },
    "health_command": {
      "type": "string",
      "minLength": 1
    },
    "trace": {
      "type": "boolean"
    },
    "concurrent": {
      "type": "boolean"
    },
    "host_api": {
      "type": "array",
      "$comment": "Host API methods the plugin asks to call as JSON-RPC host/<name> over its stdio; each needs the operator's grant at trust.",
      "uniqueItems": true,
      "items": {
        "enum": ["records.search", "records.fetch", "events.publish"]
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 32,
      "$comment": "Optional seat tools. Seats see plugin_tool_<provider>_<name> (at most 64 bytes); the host calls the plugin's MCP tool tool_<name>.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "role": {
            "enum": [
              "worker",
              "oracle"
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "input_schema",
          "output_schema",
          "role",
          "timeout_ms"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "name",
    "version",
    "shape_version",
    "systems",
    "health_command"
  ],
  "additionalProperties": true
}
