module specs.Toggle

spec Toggle {
  intent "Two flags toggle together."
  state {
    x: Bool = false
    emit: Bool = false
  }
  event Toggle
  on Toggle {
    case toggle if true => { x = !x }
  }
  invariant TOGGLE_001 "the flag is a flag" = x || !x
  scenario "toggle" {
    Toggle ~> accepted
    expect x
  }
}
