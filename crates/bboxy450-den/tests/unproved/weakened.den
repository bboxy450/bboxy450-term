module specs.Weakened

spec Weakened {
  intent "Two flags toggle together."
  state {
    x: Bool = false
    y: Bool = false
  }
  event Toggle
  on Toggle {
    case toggle if true => { x = !x; y = !y }
  }
  theorem WEAK_001 "the flags agree" = x == y
  scenario "toggle both flags" {
    Toggle ~> accepted
    expect x && y
  }
}
