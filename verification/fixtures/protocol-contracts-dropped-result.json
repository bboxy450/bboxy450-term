{
  "contract": "ResultContract",
  "required_ids": [],
  "require_reachable": [
    "Submit::fresh",
    "Submit::reused",
    "Complete::current",
    "Complete::stale",
    "Cancel::clear"
  ],
  "scope": {
    "domains": [
      {
        "name": "Id",
        "size": 2,
        "variants": [
          "A",
          "B"
        ]
      }
    ],
    "bounds": [
      {
        "name": "desired",
        "min": -1,
        "max": 1
      },
      {
        "name": "visible",
        "min": -1,
        "max": 1
      },
      {
        "name": "submitted::A",
        "min": 0,
        "max": 1
      },
      {
        "name": "submitted::B",
        "min": 0,
        "max": 1
      },
      {
        "name": "pending::A",
        "min": 0,
        "max": 1
      },
      {
        "name": "pending::B",
        "min": 0,
        "max": 1
      }
    ],
    "state_limit": 100000,
    "fairness_assumed": [],
    "assumptions": [
      "atomic pure protocol steps",
      "effects and environment outside the model"
    ],
    "waivers": []
  }
}
