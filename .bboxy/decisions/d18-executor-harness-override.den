    links = json"[{\"rel\":\"supersedes-as-index\",\"to\":\"[[2026-10-22-architecture-round-1#18]]\"},{\"rel\":\"decides\",\"to\":\"[[mcp-control-plane]]\"}]"
    number = json"18"
