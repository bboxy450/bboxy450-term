from pathlib import Path
import hashlib,json,subprocess,tarfile
base=Path('crates/bboxy-firehose/reference')
result=subprocess.run(['npm','pack','@xterm/addon-unicode11@0.9.0','--pack-destination',str(base),'--json'],capture_output=True,text=True,check=True)
info=json.loads(result.stdout)[0]
print(json.dumps({k:info[k] for k in ['name','version','filename','integrity']}))
print([f['path'] for f in info['files'] if f['path'].startswith('lib/') or f['path']=='LICENSE'])
with tarfile.open(base/info['filename']) as archive:
    for name,out in [('package/lib/addon-unicode11.js','addon-unicode11.js'),('package/LICENSE','unicode11-LICENSE')]:
        (base/'vendor'/out).write_bytes(archive.extractfile(name).read())
p=base/'vendor/provenance.json'
r=json.loads(p.read_text())
r['unicodeAddon']={'package':info['name'],'version':info['version'],'integrity':info['integrity']}
for name in ['addon-unicode11.js','unicode11-LICENSE']:
    r['sha256'][name]=hashlib.sha256((base/'vendor'/name).read_bytes()).hexdigest()
p.write_text(json.dumps(r,indent=2)+'\n')
PY

