from pathlib import Path
import shlex,subprocess,sys
commands=[['cargo','fmt','--check','-p','bboxy-firehose'],['cargo','test','-p','bboxy-firehose'],['cargo','clippy','-p','bboxy-firehose','--all-targets','--','-D','warnings'],['cargo','build','--release','-p','bboxy-firehose'],['git','diff','--check']]
failed=False
with Path('.bboxy/runs/t1-validation.log').open('w') as log:
    for command in commands:
        result=subprocess.run(command,capture_output=True,text=True)
        heading=f'$ {shlex.join(command)}\n'
        log.write(heading+result.stdout+result.stderr+f'exit_status={result.returncode}\n\n')
        log.flush()
        print(heading+result.stdout+result.stderr+f'exit_status={result.returncode}',flush=True)
        failed |= result.returncode != 0
sys.exit(int(failed))
PY

