  "reproduce_command": "python3 /tmp/rook-r5g-frame-oc2eujtr/analysis/reproduce.py (EXIT 0); no runtime load or RPC",
  "reproduce_program": "\"\"\"Reproduce the bounded frame partition from the retained immutable packet.\"\"\"\nfrom pathlib import Path\nimport csv\nimport hashlib\nimport json\nimport statistics\n\nart = Path(__file__).resolve().parent.parent\nrun = art / \"run-1\"\nresult = json.loads((run / \"result.json\").read_text())\npacket = Path(result[\"diagnostic_table\"])\ntable = json.loads(packet.read_text())\nstart, end = table[\"capture_at_stop\"], table[\"capture_at_timeout\"]\nowners = {}\nfor name in (\"logic\", \"supervisor\"):\n    a, b = start[name], end[name]\n    assert a[\"enabled\"] and b[\"enabled\"] and a[\"process_id\"] == b[\"process_id\"]\n    wall = b[\"sampled_ns\"] - a[\"sampled_ns\"]\n    assert wall > 0\n    old = dict(a[\"totals\"])\n    phases = {}\n    for phase, total in b[\"totals\"]:\n        delta = {key: total[key] - old[phase][key] for key in\n                 (\"calls\", \"elapsed_ns\", \"work\", \"bytes\", \"errors\", \"busy\")}\n        assert all(value >= 0 for value in delta.values())\n        delta[\"wall_fraction\"] = delta[\"elapsed_ns\"] / wall\n        phases[phase] = delta\n    owners[name] = {\"wall_ns\": wall, \"process_id\": b[\"process_id\"],\n                    \"missed_delta\": b[\"missed\"] - a[\"missed\"],\n                    \"overwritten_delta\": b[\"overwritten_spans\"] - a[\"overwritten_spans\"],\n                    \"untracked_delta\": b[\"untracked_seat_samples\"] - a[\"untracked_seat_samples\"],\n                    \"in_flight_start\": dict(a[\"in_flight\"]),\n                    \"in_flight_end\": dict(b[\"in_flight\"]), \"phases\": phases}\n\nbefore = {(r[\"seat\"], r[\"generation\"]): r for r in start[\"logic\"][\"seats\"]}\nafter = {(r[\"seat\"], r[\"generation\"]): r for r in end[\"logic\"][\"seats\"]}\nrows = []\nfor row in table[\"seats\"]:\n    key = row[\"seat\"], row[\"generation\"]\n    a, b = before[key], after[key]\n    gui = row[\"gui_at_timeout\"]\n    cursors = [gui.get(k) for k in (\"received\", \"applied\", \"applied_queued\", \"applied_written\")]\n    current = row[\"logic_current_snapshot\"][\"cursor\"][\"sequence\"]\n    ring = row[\"supervisor_ring_tail\"]\n    rows.append({\"name\": row[\"name\"], \"seat\": row[\"seat\"],\n                 \"stop_sequence\": a[\"applied_sequence\"], \"timeout_sequence\": b[\"applied_sequence\"],\n                 \"parsed_delta\": b[\"applied_sequence\"] - a[\"applied_sequence\"],\n                 \"pages_delta\": b[\"pages\"] - a[\"pages\"],\n                 \"end_observed_after_stop\": b[\"applied_observed_ns\"] > start[\"logic\"][\"sampled_ns\"],\n                 \"gui_four_cursors_match\": all(x is not None for x in cursors) and all(x == cursors[0] for x in cursors[1:]),\n                 \"later_logic_sequence\": current, \"later_ring_sequence\": ring[\"captured_sequence\"],\n                 \"later_ring_minus_logic\": ring[\"captured_sequence\"] - current,\n                 \"logic_paused\": row[\"logic_current_snapshot\"][\"has_paused\"],\n                 \"ring_paused\": ring[\"paused_in_examined_tail\"],\n                 \"ring_error\": ring[\"error\"], \"ring_gap\": ring[\"gap\"]})\n\npages = sum(row[\"pages_delta\"] for row in rows)\nprogress = [row[\"parsed_delta\"] for row in rows]\ngaps = [row[\"later_ring_minus_logic\"] for row in rows]\nreport = {\"source\": json.loads((art / \"binary.json\").read_text())[\"source\"],\n          \"diagnostic_sha256\": hashlib.sha256(packet.read_bytes()).hexdigest(),\n          \"interval\": \"stop_to_timeout_only; settled_boundary_not_observed\",\n          \"official_stop_to_settled_gate\": \"unproven\", \"owners\": owners,\n          \"watched_pages\": pages,\n          \"watched_page_fraction\": pages / owners[\"logic\"][\"phases\"][\"read_ring_rpc\"][\"calls\"],\n          \"progress\": {\"count\": len(progress), \"positive\": sum(x > 0 for x in progress),\n                       \"min\": min(progress), \"median\": statistics.median(progress), \"max\": max(progress)},\n          \"later_ring_minus_logic\": {\"min\": min(gaps), \"median\": statistics.median(gaps), \"max\": max(gaps)}}\nout = Path(__file__).parent\n(out / \"reproduced-core.json\").write_text(json.dumps(report, indent=2, sort_keys=True) + \"\\n\")\nwith (out / \"reproduced-seats.csv\").open(\"w\") as f:\n    writer = csv.DictWriter(f, fieldnames=list(rows[0]))\n    writer.writeheader()\n    writer.writerows(rows)\nprint(json.dumps({\"checkpoint_rpc_fraction\": owners[\"logic\"][\"phases\"][\"checkpoint_rpc\"][\"wall_fraction\"],\n                  \"read_ring_fraction\": owners[\"logic\"][\"phases\"][\"read_ring_rpc\"][\"wall_fraction\"],\n                  \"watched_page_fraction\": report[\"watched_page_fraction\"], \"progress\": report[\"progress\"]}))\n",
