import datetime,hashlib,json,os,pathlib,subprocess,sys,time
s=pathlib.Path(__file__).parent
label=sys.argv[1]
log=s/(label+'-build.log')
artifacts=[]
for line in log.read_text().splitlines():
 try: item=json.loads(line)
 except ValueError: continue
 if item.get('reason')=='compiler-artifact' and item.get('target',{}).get('name')=='identity' and item.get('executable'): artifacts.append(item['executable'])
assert len(set(artifacts))==1,artifacts
binary=pathlib.Path(artifacts[-1]);test='native_two_item_regrant_keeps_the_second_hold_and_completes_in_pending_order'
cwd='/Users/feral/mydev/bboxy450-term-exec5'
env=os.environ.copy();env.update({'BBOXY_TEST_CUSTODY':'memory','RUSTC_WRAPPER':'','RUSTC_WORKSPACE_WRAPPER':''})
meta={'source':subprocess.check_output(['git','rev-parse','HEAD'],cwd=cwd,text=True).strip(),'binary':str(binary),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'target':cwd+'/target/settings-plugins-dev','utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'load_before':os.getloadavg(),'runs':[]}
meta_path=s/(label+'-30.json')
for i in range(1,31):
 command=[str(binary),'--exact',test,'--nocapture','--test-threads=1'];started=time.time();out=s/(label+'-run-'+str(i).zfill(2)+'.log')
 with out.open('w') as handle:
  child=subprocess.Popen(command,cwd=cwd,env=env,stdout=handle,stderr=subprocess.STDOUT,start_new_session=True)
  record={'run':i,'pid':child.pid,'pgid':child.pid,'log':str(out),'command':command};meta['runs'].append(record);meta_path.write_text(json.dumps(meta,indent=2)+'\n')
  try: code=child.wait(timeout=45)
  except subprocess.TimeoutExpired:
   os.killpg(child.pid,15)
   try: child.wait(timeout=3)
   except subprocess.TimeoutExpired: os.killpg(child.pid,9);child.wait()
   code=124
 content=out.read_text();passed=code==0 and 'test result: ok. 1 passed; 0 failed;' in content
 record.update(exit_code=code,passed=passed,elapsed_s=time.time()-started,sha256=hashlib.sha256(out.read_bytes()).hexdigest())
 meta.update(passed=sum(r.get('passed',False) for r in meta['runs']),failed=sum('exit_code'in r and not r['passed'] for r in meta['runs']))
 meta_path.write_text(json.dumps(meta,indent=2)+'\n')
 if not passed or i%5==0: print(json.dumps({'label':label,'run':i,'exit':code,'passed':passed,'counts':[meta['passed'],meta['failed']]}),flush=True)
meta['load_after']=os.getloadavg();meta['complete']=len(meta['runs'])==30;meta_path.write_text(json.dumps(meta,indent=2)+'\n')
raise SystemExit(0 if meta['failed']==0 else 1)


