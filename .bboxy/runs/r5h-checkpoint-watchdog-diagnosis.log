     pub struct Recorder {
         buffer: OnceLock<Mutex<Buffer>>,
         fixture_lossless: AtomicBool,
+        fixture_drop_final_from: AtomicU64,
         turn: AtomicU64,
         pages: AtomicU64,
         missed: AtomicU64,
@@ -329,6 +330,11 @@
             }
         }

+        /// Temporary diagnostic fault: drop final cursor publications only.
+        pub fn diagnostic_drop_final_rows(&self, from: u64) {
+            self.fixture_drop_final_from.store(from, Ordering::Relaxed);
+        }
+
         pub fn seat(&self, seat: Ulid, generation: u64, f: impl FnOnce(&mut Seat, u64)) {
             self.update(|buffer| {
                 if !buffer.seats.contains_key(&seat) && buffer.seats.len() == SEATS {
@@ -343,9 +349,15 @@
                         ..Seat::default()
                     };
                 }
+                let cutoff = self.fixture_drop_final_from.load(Ordering::Relaxed);
+                let previous = (cutoff != 0).then(|| row.clone());
                 let now = now_ns();
                 row.observed_ns = now;
                 f(row, now);
+                if cutoff != 0 && row.parsed_byte_end >= cutoff {
+                    *row = previous.unwrap();
+                    self.missed.fetch_add(1, Ordering::Relaxed);
