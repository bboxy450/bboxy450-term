+
+#[test]
+fn diagnostic_lost_final_row_reproduces_false_parser_watchdog() {
+    let fixture = Fixture::new();
+    fixture.spawn(fixture.seat, 100 * 1024 * 1024);
+    let (through, end) = fixture.start_and_capture(100 * 1024 * 1024);
+    fixture.logic().client.diagnostic_drop_final_capture_rows(end);
+    fixture.held.store(false, Ordering::Release);
+    let started = Instant::now();
+    loop {
+        let actual = fixture.runtime.block_on(fixture.logic().client.snapshot(fixture.seat, 1)).unwrap();
+        if actual.sequence >= through {
+            println!("AUTHORITATIVE_BEFORE_WATCHDOG sequence={} required={} elapsed_s={}", actual.sequence, through, started.elapsed().as_secs_f64());
+            break;
+        }
+        assert!(started.elapsed() < Duration::from_secs(120), "diagnostic authoritative parser never caught up");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    let before = fixture.row(fixture.seat).unwrap();
+    assert!(before.parsed_byte_end < end);
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| fixture.catch_up(through, end)));
+    let panic = result.expect_err("unchanged watchdog should reject the deliberately stale row");
+    let reason = panic.downcast_ref::<String>().map(String::as_str).or_else(||panic.downcast_ref::<&str>().copied()).unwrap_or("");
+    assert!(reason.starts_with("parser stopped advancing"));
+    let actual = fixture.runtime.block_on(fixture.logic().client.snapshot(fixture.seat, 1)).unwrap();
+    let stale = fixture.row(fixture.seat).unwrap();
+    assert!(actual.sequence >= through);
+    assert!(stale.parsed_byte_end < end);
+    assert!(fixture.saves.lock().unwrap()[&fixture.seat].last().copied().unwrap() >= end);
+    println!("FORCED_ROW_LOSS_RESULT actual_sequence={} required={} stale_parsed_end={} expected_end={} missed={}", actual.sequence, through, stale.parsed_byte_end, end, fixture.logic().client.capture_diagnostics().missed);
+    fixture.logic().client.diagnostic_drop_final_capture_rows(0);
+    fixture.runtime.block_on(fixture.logic().client.snapshot(fixture.seat, 1)).unwrap();
+    assert!(fixture.row(fixture.seat).unwrap().parsed_byte_end >= end);
+    fixture.catch_up(through, end);
+    fixture.finish();
+}

