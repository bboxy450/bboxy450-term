Actual OS main vs worker raster regression; main and worker asserted via pthread_main_np.
PROBE SOURCE:
use bbt_render::{FontConfig, text::terminal::Fonts};
#[link(name = "System")]
unsafe extern "C" { fn pthread_main_np() -> i32; }
fn main() {
    assert_eq!(unsafe { pthread_main_np() }, 1, "baseline must run on OS main thread");
    let cases = [("F",1),("e\u{301}",1),("中",2),("👩\u{200d}💻",2)];
    let mut count = 0;
    for scale in [1,2] {
        let fonts = Fonts::new(&FontConfig {scale,..Default::default()},None,false).unwrap();
        let capture = move |fonts: &Fonts| {
            let mut result = Vec::new();
            for (text,span) in cases {
                for (bold,italic) in [(false,false),(true,false),(false,true),(true,true)] {
                    let g = fonts.rasterize(text,bold,italic,span).unwrap().unwrap();
                    result.push((g.width,g.height,g.left,g.top,g.format,g.pixels,g.faces));
                }
            }
            result
        };
        let before = capture(&fonts);
        let after = std::thread::spawn(move || {
            assert_eq!(unsafe {pthread_main_np()},0,"worker must differ from main thread");
            capture(&fonts)
        }).join().unwrap();
        assert_eq!(before,after,"main/worker raster differs at scale {scale}");
        count += before.len();
    }
    println!("OS main vs worker: {count}/32 raster pairs byte-identical (4 glyph clusters, 4 styles, 2 scales)");
}

