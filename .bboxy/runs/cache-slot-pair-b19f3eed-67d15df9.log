DRIVER SOURCE (executed; raw log receipts stored separately)
"""Run the Oracle-requested two real normal gates at one admitted slot path."""
import argparse
from contextlib import ExitStack
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
api = None


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def statistics(environment, path):
    result = subprocess.run(["sccache", "--show-stats", "--stats-format", "json"],
                            env=environment, capture_output=True, text=True, timeout=15)
    path.write_text(result.stdout)
    path.with_suffix(".stderr").write_text(result.stderr)
    if result.returncode:
        raise RuntimeError("native cache statistics failed: " + str(result.returncode))
    return json.loads(result.stdout)


def rust_counts(stats):
    return [stats.get("stats", {}).get(field, {}).get("counts", {}).get("Rust", 0)
            for field in ("cache_hits", "cache_misses")]


def interrupt(signum, unused):
    raise InterruptedError("received signal " + str(signum))


def gate(number, sha, proof, lease):
    tree, environment = api.candidate_environment(ROOT, sha)
    target = Path(environment["BBOXY_CARGO_TARGET_DIR"])
    assert not list(target.iterdir())
    checksum = int(subprocess.check_output(["cksum"], input=os.fsencode(tree.resolve())).split()[0])
    environment.update(BBOXY_GATE_SLOT="none", SCCACHE_SERVER_PORT=str(4300 + checksum % 1000),
                       SCCACHE_IDLE_TIMEOUT="7200", BBOXY_TEST_CUSTODY="memory")
    environment.pop("SCCACHE_SERVER_UDS", None)
    assert "CARGO_TARGET_DIR" not in environment
    before = statistics(environment, proof / f"gate-{number}-stats-before.json")
    log = proof / f"gate-{number}.log"
    started = time.monotonic()
    with log.open("w") as stream:
        child = subprocess.Popen(["sh", "scripts/ci-local.sh"], cwd=tree, env=environment,
                                 stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT,
                                 start_new_session=True)
        process = {"pid": child.pid, "pgid": child.pid, "sha": sha, "slot": lease.number,
                   "tree": str(tree), "target": str(target), "started_at": api.now(),
                   "cache_port": environment["SCCACHE_SERVER_PORT"]}
        save(proof / f"gate-{number}-process.json", process)
        print(json.dumps({"gate_started": process}), flush=True)
        try:
            code = child.wait()
        finally:
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
    after = statistics(environment, proof / f"gate-{number}-stats-after.json")
    a, b = rust_counts(before), rust_counts(after)
    delta = [b[i] - a[i] for i in range(2)]
    result = dict(process, exit=code, elapsed_seconds=time.monotonic() - started,
                  rust_hits=delta[0], rust_misses=delta[1], log=str(log),
                  log_sha256=hashlib.sha256(log.read_bytes()).hexdigest())
    if min(delta) < 0:
        result["counter_epoch_changed"] = True
    else:
        result["rust_hit_rate"] = delta[0] / sum(delta) if sum(delta) else None
    if code == 0:
        result["receipt"] = api.gate_proof(log, sha)
    save(proof / f"gate-{number}-result.json", result)
    print(json.dumps({"gate_finished": result}), flush=True)
    if code:
        raise RuntimeError("real normal gate failed: " + str(code))
    return result


def main():
    global api
    parser = argparse.ArgumentParser()
    parser.add_argument("first")
    parser.add_argument("--proof", required=True)
    parser.add_argument("--preferred", type=int)
    parser.add_argument("--wait-seconds", type=float, default=0)
    args = parser.parse_args()
    proof = Path(args.proof).resolve()
    proof.mkdir(parents=True, exist_ok=False)
    first = git("rev-parse", args.first)
    subprocess.run(["git", "fetch", "origin", "main"], check=True)
    subprocess.run(["git", "merge-base", "--is-ancestor", first, "origin/main"], check=True)
    entry = proof / "landing.py"
    entry.write_text(git("show", first + ":scripts/landing.py") + "\n")
    spec = importlib.util.spec_from_file_location("landing", entry)
    api = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(api)
    save(proof / "entry.json", {"source": first, "path": str(entry),
                               "sha256": hashlib.sha256(entry.read_bytes()).hexdigest()})
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    results = []
    deadline = time.monotonic() + args.wait_seconds
    with ExitStack() as stack:
        while True:
            try:
                lease = stack.enter_context(api.Slot("cache-proof", preferred=args.preferred))
                break
            except api.Refusal as error:
                if error.code != 75 or time.monotonic() >= deadline:
                    raise
                print(json.dumps({"slots_busy": True, "at": api.now()}), flush=True)
                time.sleep(min(30, max(0, deadline - time.monotonic())))
        save(proof / "owner.json", {"pid": os.getpid(), "slot": lease.number, "first": first})
        results.append(gate(1, first, proof, lease))
        subprocess.run(["git", "fetch", "origin", "main"], check=True)
        second = git("rev-parse", "origin/main")
        if second == first:
            raise RuntimeError("first gate complete; a distinct landed main SHA is required")
        results.append(gate(2, second, proof, lease))
        assert results[0]["tree"] == results[1]["tree"]
        assert results[0]["target"] == results[1]["target"]
        assert results[1].get("rust_hit_rate") is not None
        assert results[1]["rust_hits"] + results[1]["rust_misses"] >= 100
        assert results[1]["rust_hit_rate"] >= .8, "second normal gate Rust hit rate is below 80%"
    save(proof / "result.json", {"exit": 0, "gates": results, "released_at": api.now(),
                               "slot_removed": not lease.path.exists()})
    print(json.dumps({"proof_passed": True, "proof": str(proof)}), flush=True)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        if api is not None and isinstance(error, api.Refusal):
            print(str(error), file=sys.stderr)
            raise SystemExit(error.code)
        raise

