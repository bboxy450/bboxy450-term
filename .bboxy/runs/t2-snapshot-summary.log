use std::{hint::black_box,time::Instant};
use bbt_core::{Term,Line,Column};
fn legacy(t:&Term,cols:usize,rows:usize)->Screen {
 let checkpoint=serde_json::to_value(t.checkpoint()).unwrap();let m=&checkpoint["model"];let g=t.grid();
 Screen {cols,rows,cells:(0..rows).map(|r|(0..cols).map(|c|g[Line(r as i32)][Column(c)].clone()).collect()).collect(),cursor:(g.cursor.point.line.0,g.cursor.point.column.0),modes:t.mode().bits() as u64,palette:m["colors"].clone(),cursor_style:if m["cursor_style"].is_null(){m["config"]["default_cursor_style"].clone()}else{m["cursor_style"].clone()},title:String::new(),cwd:None,gap:None}
}

use bbt_proto::Screen;
fn timed(mut f:impl FnMut(),n:usize)->serde_json::Value {
    for _ in 0..5 { f(); }
    let mut samples=Vec::with_capacity(n);
    for _ in 0..n { let at=Instant::now(); f(); samples.push(at.elapsed().as_secs_f64()*1000.); }
    samples.sort_by(f64::total_cmp);
    serde_json::json!({"n":n,"mean_ms":samples.iter().sum::<f64>()/n as f64,"p50_ms":samples[n/2],"p95_ms":samples[n*95/100],"min_ms":samples[0]})
}
fn main(){
    for (cols,rows,history) in [(38,57,0),(77,57,0),(158,57,0)] {
        let mut term=Term::new(cols,rows,history);
        let bytes=(1..=rows+history+10).map(|n|format!("{n}\r\n")).collect::<String>();
        term.advance(bytes.as_bytes());
        let screen=Screen::from_term(&term,String::new(),None,None);
        assert_eq!(screen,legacy(&term,cols,rows));
        let checkpoint_bytes=serde_json::to_vec(&term.checkpoint()).unwrap().len();
        let result=serde_json::json!({"cols":cols,"rows":rows,"history_limit":history,"checkpoint_bytes":checkpoint_bytes,
          "legacy_from_term_same_binary":timed(||{black_box(legacy(&term,cols,rows));},100),
          "checkpoint_clone":timed(||{black_box(term.checkpoint());},100),
          "checkpoint_to_json_value":timed(||{black_box(serde_json::to_value(term.checkpoint()).unwrap());},100),
          "screen_from_term":timed(||{black_box(Screen::from_term(&term,String::new(),None,None));},100),
          "visible_cells_clone":timed(||{let rows:Vec<Vec<_>>=(0..rows).map(|r|(0..cols).map(|c|term.grid()[Line(r as i32)][Column(c)].clone()).collect()).collect();black_box(rows);},100),
          "screen_json_wire":timed(||{black_box(serde_json::to_vec(&screen).unwrap());},100)});
        println!("{result}");
    }
}

