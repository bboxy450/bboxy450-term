Final driver (first run used the documented11s variant before PNG completion checks):
from pathlib import Path
import datetime,hashlib,json,os,re,subprocess,tempfile,time,sys

scratch=Path(__file__).parent
root=Path(tempfile.mkdtemp(prefix='native-scroll-',dir=scratch))
repo=root/'repository';repo.mkdir()
config=root/'zsh';config.mkdir()
(config/'.zshrc').write_text("for ((i=1;i<=20000;i++)); do printf 'line %05d\\r\\n' \"$i\"; done\nexec /bin/cat\n")
binary=Path(sys.argv[1]) if len(sys.argv)>1 else Path('/Users/feral/mydev/bboxy450-term-exec3/target/dev/debug/bboxy450-term')
png=root/'scroll.png'
argv=[str(binary),'--meter','--spawn-zsh','1','--scroll-top-after','5','--capture',str(png),'--capture-after','8','--grid-hash','--quit-after','20','--run-dir',str(root/'run')]
env=dict(os.environ,BBOXY_TEST_CUSTODY='memory',ZDOTDIR=str(config))
env.pop('BBOXY_VERIFY_INPUT',None)
start=time.monotonic()
with (root/'app.log').open('w') as log:
    app=subprocess.Popen(argv,cwd=repo,env=env,stdout=log,stderr=subprocess.STDOUT)
    process={'argv':argv,'cwd':str(repo),'env':{'BBOXY_TEST_CUSTODY':'memory','ZDOTDIR':str(config)},'pid':app.pid,'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest()}
    (root/'process.json').write_text(json.dumps(process,indent=2))
    print('NATIVE_ROOT',root,'OWNED_APP_PID',app.pid,flush=True)
    try:
        code=app.wait(timeout=45)
    except subprocess.TimeoutExpired:
        app.terminate()
        try:code=app.wait(timeout=10)
        except subprocess.TimeoutExpired:
            app.kill();code=app.wait()
        raise RuntimeError(f'owned app timed out; exit {code}; inspect recorded children in {root}')
process.update(exit=code,elapsed_seconds=time.monotonic()-start)
(root/'process.json').write_text(json.dumps(process,indent=2))
text=(root/'app.log').read_text()
pids=[int(pid) for pid in re.findall(r'(?:supervisor|logic)=(\d+)',text)]
(root/'owned-child-pids.json').write_text(json.dumps(pids))
print(text)
print('APP_EXIT',code,'ELAPSED',process['elapsed_seconds'])
assert code==0
report=json.loads(png.with_suffix('.grid.json').read_text())
assert len(report['panes'])==1,report
pane=report['panes'][0]
assert pane['history']['lines'][0]=='line 00001',pane
print('PASS_NATIVE_FIRST_ROW',pane['history']['lines'][0],'FNV',pane['fnv1a64'],'LIVE_FNV',pane['history']['live_fnv1a64'])
assert png.is_file()
assert text.count(f'capture {png}: Ok(())')==2,'both the initial and delayed PNG writes must finish'
assert png.stat().st_mtime_ns>=png.with_suffix('.grid.json').stat().st_mtime_ns,'delayed capture did not replace initial PNG'
assert 'cockpit children reaped after orderly shutdown' in text
assert 'memory custody (debug)' in text or 'unsigned, local only' in text, 'read footer for actual custody before accepting this run'
for pid in pids:
    try:os.kill(pid,0)
    except ProcessLookupError:continue
    raise AssertionError(f'owned child {pid} still exists after app exit')
print('PASS_NATIVE_OWNED_CHILDREN_REAPED')
(scratch/'last-native.json').write_text(json.dumps({'root':str(root),'process':process},indent=2))
