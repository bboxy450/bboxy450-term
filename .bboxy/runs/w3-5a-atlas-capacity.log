use std::{collections::HashSet, error::Error, path::Path};
use bbt_render::{atlas::GlyphAtlas, chrome::text::rasterize_at};
use bbt_ui::{self as ui, components as c};
use bbt_ui_model::{draw::{DrawCtx, Prim}, layout::Rect};
type Result<T> = std::result::Result<T, Box<dyn Error>>;

fn visit(primitives: &[Prim], atlas: &mut GlyphAtlas, keys: &mut HashSet<String>) -> Result<bool> {
    for prim in primitives {
        match prim {
            Prim::Group { primitives, .. } => if !visit(primitives, atlas, keys)? { return Ok(false); },
            Prim::Text { origin, text, style, max_width, .. } if !text.is_empty() => {
                let scale = 1_f32;
                let phase = (origin[0] * scale).rem_euclid(1.);
                let key = format!("{text}\0{style:?}\0{max_width:?}\0{scale}\0{phase}");
                if keys.contains(&key) { continue; }
                let line = rasterize_at(text, *style, *max_width, scale, phase)?;
                if let Err(error) = atlas.insert(line.width, line.height, &line.mask) {
                    println!("failure={error}; cached_line_masks={}; atlas={}x{}; failed_mask={}x{}; scale={scale}", keys.len(), atlas.size(), atlas.size(), line.width, line.height);
                    return Ok(false);
                }
                keys.insert(key);
            }
            _ => {},
        }
    }
    Ok(true)
}
fn paints(ops: &[c::Paint], atlas: &mut GlyphAtlas, keys: &mut HashSet<String>) -> Result<bool> {
    for op in ops {
        let ok = match op {
            c::Paint::Group { ops, .. } => paints(ops, atlas, keys)?,
            c::Paint::Draw(list) | c::Paint::Underlay(list) => visit(&list.primitives, atlas, keys)?,
            c::Paint::Material { .. } => true,
        };
        if !ok { return Ok(false); }
    }
    Ok(true)
}
fn main() -> Result<()> {
    let root_arg = std::env::args().nth(1).expect("worktree");
    let root = Path::new(&root_arg);
    let metrics = bboxybook::settings::Metrics::default();
    let mut atlas = GlyphAtlas::new(512, 8192)?;
    let mut keys = HashSet::new();
    for (index, path) in bboxybook::documents::repository::inputs(root)?.into_iter().enumerate() {
        let source = std::fs::read_to_string(root.join(&path))?;
        let doc = bbt_doc::parse(&source);
        for theme in [ui::Theme::Dark, ui::Theme::Light] {
            let ctx = ui::Context::new(theme, ui::Density::Cozy);
            let element = doc.modal_element(&path.to_string_lossy(), false, [1246., 900.], ctx, &metrics);
            let first = element.layout(Rect::new(0., 0., 1246., 0.), ctx, &metrics)?;
            let last = (first.rect.h - 900.).max(0.);
            let mut offsets = vec![0.];
            if last > 900. { offsets.push(last * 0.5); }
            if last > 1. { offsets.push(last); }
            for offset in offsets {
                let layout = if offset == 0. { first.clone() } else { element.layout(Rect::new(0., -offset, 1246., 0.), ctx, &metrics)? };
                if !paints(&c::paint_with_draw(&layout, DrawCtx::new(theme, ctx.density)), &mut atlas, &mut keys)? {
                    println!("document_index={}; path={}; theme={theme:?}; offset={offset}; source=public-rasterizer-and-shelf-packing-replay", index + 1, path.display());
                    return Ok(());
                }
            }
        }
    }
    Err("corpus did not reproduce the capacity limit".into())
}

