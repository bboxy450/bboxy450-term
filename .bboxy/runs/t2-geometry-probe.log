use std::{fs,path::PathBuf};
fn main() -> bboxybook::Result<()> {
 let args:Vec<_>=std::env::args().collect(); let out=PathBuf::from(&args[2]);fs::create_dir_all(&out)?;
 let cases:Vec<bboxybook::gallery::Case>=serde_json::from_slice(&fs::read(&args[1])?)?;
 let surfaces=bboxybook::overlays::surface_snapshots(&cases)?;
 fs::write(out.join("surface-layouts.json"),serde_json::to_vec_pretty(&surfaces)?)?;
 let mut s=bboxybook::components::snapshots(&cases)?;
 s.extend(bboxybook::styles::snapshots(&cases)?);s.extend(bboxybook::atoms::snapshots(&cases)?);
 s.extend(bboxybook::seat_rows::snapshots(&cases)?);s.extend(bboxybook::tabs::snapshots(&cases)?);
 s.extend(bboxybook::swarms::snapshots(&cases)?);s.extend(bboxybook::panes::snapshots(&cases)?);
 s.extend(bboxybook::title_bars::snapshots(&cases)?);s.extend(bboxybook::launchers::snapshots(&cases)?);
 s.extend(bboxybook::streams::snapshots(&cases)?);s.extend(bboxybook::graphs::snapshots(&cases)?);
 s.extend(bboxybook::settings::snapshots(&cases)?);s.extend(bboxybook::paths::snapshots(&cases)?);
 fs::write(out.join("layouts.json"),serde_json::to_vec_pretty(&s)?)?;
 println!("{} native geometry records for {} prefix cases, using the same public functions as parity::render",s.len(),cases.len());Ok(())
}
