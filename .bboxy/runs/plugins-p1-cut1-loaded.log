FILE cut1-loaded.py SHA256 4647a5531f47c015108356f518513eb386a44a262e91683f5ff5f99cb832e346
import hashlib,json,os,re,shutil,signal,subprocess,tempfile,time
from pathlib import Path
p=Path(__file__).parent
repo=Path('/Users/feral/mydev/bboxy450-term-exec5')
name='deadline_failure_is_named_and_another_plugin_job_remains_independent'
log=(p/'cut1-host-3.log').read_text()
binary=Path(re.search(r'Running tests/plugin_registry.rs \(([^)]+)\)',log).group(1))
assert not subprocess.check_output(['git','diff','HEAD','--name-only'],cwd=repo,text=True).strip()
run=Path(tempfile.mkdtemp(prefix='deadline-load-',dir=p))
(p/'cut1-load-current').write_text(str(run)+'\n')
state={'source':subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip(),'test':name,'binary':str(binary),'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'driver_pid':os.getpid(),'builds':[],'runs':[]}
workers=[];handles=[];seen=set()
def save():
 (run/'state.json').write_text(json.dumps(state,indent=2)+'\n')
def members():
 rows=subprocess.check_output(['ps','-axo','pid=,ppid=,pgid=,comm='],text=True).splitlines();out=[]
 groups={proc.pid for proc in workers}
 for line in rows:
  fields=line.strip().split(None,3)
  if len(fields)==4 and int(fields[2]) in groups:
   record={'pid':int(fields[0]),'ppid':int(fields[1]),'pgid':int(fields[2]),'comm':fields[3]};out.append(record);seen.add(record['pid'])
 return out
try:
 for label,package,target_kind in [('a','bbt-mux','--lib'),('b','bboxy450-term','--tests')]:
  target=run/f'build-{label}-target'
  env=dict(os.environ,RUSTC_WRAPPER='',RUSTC_WORKSPACE_WRAPPER='',CARGO_BUILD_JOBS='2',CARGO_NET_OFFLINE='true',BBOXY_TEST_CUSTODY='memory',CARGO_TARGET_DIR=str(target),CARGO_PROFILE_DEV_DEBUG='0',CARGO_PROFILE_TEST_DEBUG='0')
  args=['cargo','test','-p',package,target_kind,'--no-run','--locked','--offline']
  output=(run/f'build-{label}.log').open('w');handles.append(output)
  child=subprocess.Popen(args,env=env,stdout=output,stderr=subprocess.STDOUT,cwd=repo,start_new_session=True)
  workers.append(child);state['builds'].append({'label':label,'argv':args,'pid':child.pid,'target':str(target),'started':time.time(),'jobs':2});save()
  print(f'load {label} PID {child.pid}',flush=True)
 guard=time.monotonic()+30
 while True:
  current=members()
  ready=all(proc.poll() is None and any(x['pgid']==proc.pid and Path(x['comm']).name=='rustc' for x in current) for proc in workers)
  if ready:break
  if any(proc.poll() is not None for proc in workers):raise RuntimeError('load build exited before the test series')
  if time.monotonic()>guard:raise RuntimeError('30 s load-start hang guard; inspect logs')
  time.sleep(0.05)
 state['load_ready']=current;save()
 for i in range(1,11):
  before=[proc.poll() for proc in workers]
  if before != [None,None]:raise RuntimeError('both cargo builds must remain running for every test')
  state['runs'].append({'n':i,'builds_before':before,'members_before':members(),'start':time.time()});save()
  args=[str(binary),name,'--exact','--test-threads=1']
  with (run/f'test-{i:02d}.log').open('w') as output:
   child=subprocess.Popen(args,cwd=repo,stdout=output,stderr=subprocess.STDOUT,start_new_session=True)
   state['runs'][-1]['pid']=child.pid;save()
   try:code=child.wait(timeout=30)
   except subprocess.TimeoutExpired:
    os.killpg(child.pid,signal.SIGKILL);child.wait();raise RuntimeError('30 s test hang guard fired')
  after=[proc.poll() for proc in workers]
  state['runs'][-1].update(exit=code,builds_after=after,members_after=members(),finished=time.time());save()
  print(f'exact test {i}/10 EXIT {code}; two builds active={after==[None,None]}',flush=True)
  if code:raise RuntimeError(f'exact test {i} failed')
  if after != [None,None]:raise RuntimeError('a load build ended during this invocation')
 state['test_series']='10/10 passed while both cargo builds remained active'
 assert hashlib.sha256(binary.read_bytes()).hexdigest()==state['binary_sha256']
except BaseException as error:
 state['error']=str(error);raise
finally:
 state['members_before_stop']=members();save()
 for proc in workers:
  if proc.poll() is None:os.killpg(proc.pid,signal.SIGTERM)
 for entry,proc in zip(state['builds'],workers):
  try:entry['exit']=proc.wait(timeout=30)
  except subprocess.TimeoutExpired:
   os.killpg(proc.pid,signal.SIGKILL);entry['exit']=proc.wait(timeout=30)
  entry['stop']='intentional load-generator stop after experiment, not a test/build verdict'
 for handle in handles:handle.close()
 guard=time.monotonic()+30
 while members():
  if time.monotonic()>guard:raise RuntimeError('owned load process cleanup hang guard')
  time.sleep(0.05)
 state['owned_groups_after']=members();state['seen_build_pids']=sorted(seen)
 for entry in state['builds']:
  target=Path(entry['target'])
  check=subprocess.run(['lsof','-nP','+D',str(target)],capture_output=True,text=True)
  entry['lsof_exit']=check.returncode
  (run/f"target-{entry['label']}-lsof.log").write_text(check.stdout+check.stderr)
  if check.returncode!=1:raise RuntimeError('load target still open or lsof failed; retained')
  shutil.rmtree(target);entry['target_removed']=True
 state['logs_sha256']={f.name:hashlib.sha256(f.read_bytes()).hexdigest() for f in run.glob('*.log')};state['finished']=time.time();save()
 print('load experiment ended; own groups empty and both load targets removed',flush=True)


