    verify_result = json"{\"command\":\"make test-boundaries && make test-formal\",\"evidence\":[{\"criterion\":\"A fake ACP agent cancels with a tool open, exits, and receives one automatic Continue after same-ID reload\",\"reference\":\"crates/bboxy450-harness/tests/acp_agent.rs:2010; target/codex-exits/verification.log (39 passed)\"},{\"criterion\":\"Without reload the process witness and formal control both fail\",\"reference\":\"target/codex-exits/no-reload-process.log (exit 101); BrokenHarnessInterruptNoReload (liveness, 48,582 states and 233,340 edges matched)\"},{\"criterion\":\"Process boundaries and current-source formal parity pass\",\"reference\":\"target/codex-exits/verification-final.log; formal receipt d2794c7a42040acf8f791f73ebab2078e949b94a59857797a13cc3e2b2b1a3e7\"},{\"criterion\":\"Historical harness Close distinguished from child EOF\",\"reference\":\"crates/bboxy450-harness/src/backend/acp_agent.rs:1031 and :1840; target/codex-exits/incident-observations.json\"}],\"exit_code\":0}"
