    status = Open
    swarm = json"\"01M7P04CW1T6KY8CMSS6DQM12Q\""
    updated = json"\"2026-11-22T15:38:40.346Z\""
    updated_by = json"\"seat:01M7VC8EK2C7DQXBNCE9V0J0MH\""
    provenance = json"{\"digest\":\"sha256:888d1090e8a3bd4ffb335d62414e494bca727583878b84459f420b13f050384d\",\"frontmatter_digest\":\"sha256:83293faf90e44858354c27eb2ef6d5f9724709b3ef81b5c7e947f8efcb0f5965\",\"signer\":\"seat:01M7VC8EK2C7DQXBNCE9V0J0MH\",\"sig\":\"BPiErI7ty7ILhaZOQQcqmi4k2Hz8P3usswrsFiQWPYxyyVzo0dEH8F0HhaT48/uu9xtLuiyoaaiKhDeV8PatDg==\",\"log\":\"bboxy://activity/index-93ad8c65834c983167272adcebd708d5016d7d1135673e1090720e78289f698a/999\",\"event\":{\"id\":\"01M81YHNJSWCEYM8TSTPYYFPJ7\",\"sequence\":999,\"hash\":\"4441434b57d38829da0353136d50099927f7f108cacb3c0f32bedb8acf6df0c9\"}}"
