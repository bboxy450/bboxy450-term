    reconciliation = json"[{\"by\":\"seat:01M7VC8EK2C7DQXBNCE9V0J0MH\",\"disposition\":\"implemented\",\"evidence\":[\"make land exit 0, LANDED b0dbefa4c8acd267537a080795a4a492310b4d2b (~/mydev/bbx-inbox/target/oracle-land4.log)\",\"origin/main 10bbaa4d4 Add the desktop question and approval inbox; b0dbefa4c gui_wire.tsv goldens for Questions/Answer (gui_wire_golden 4/4)\",\"harness 0d503aee (first answer wins, answered_by) on harness main, pinned via main's 0b9c2e85\",\"make test-formal exit 0 (oracle-formal.log); executor: race test 19/19, desktop inbox 1/1, test-boundaries 23/23; capture target/desktop-inbox.png (Oracle viewed)\",\"land3 flaked once on provenance::twenty_commit_rebase_keeps_control_requests_responsive (fixture temp dir vanished); land4 passed\"],\"fresh_accepted\":false,\"kind\":\"historical\",\"op_id\":\"01M7Y59GB1Q3EX93C19WMNJDPQ\",\"previous_status\":\"claimed\",\"reason\":\"Executor seats exited before landing; Oracle added the missing #320 wire goldens, rebased and landed.\"}]"
    role = json"\"executor\""
