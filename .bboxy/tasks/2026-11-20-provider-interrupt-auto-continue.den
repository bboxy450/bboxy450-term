    reconciliation = json"[{\"by\":\"seat:01M7VC8EK2C7DQXBNCE9V0J0MH\",\"disposition\":\"implemented\",\"evidence\":[\"make land exit 0, LANDED a05e43aef7c8ab33142fdaac409fb2caade63a89 (~/mydev/bbx-interrupt/target/interrupt-handoff/oracle-land2.log); land1 failed only because the Oracle restarted the kache daemon mid-compile\",\"make test-boundaries exit 0, make test-formal exit 0 (oracle-boundaries.log, oracle-formal.log)\",\"harness main: c50a9767 owned continuation deadline + recovery; 8d8a1c34 additive interrupt wire; b8987a1c idle on reported close; 7c21b3e5 formal inventory\",\"harness src/interrupt.rs: one catalogue of 16 causes (provider.capacity/rate_limit/overloaded/5xx/auth, agent.exited/protocol/config/cancelled, harness.exited/panic, hook.failed, mcp.unavailable, tool.timeout, context.max_tokens, turn.max_rounds), provider code -> JSON-RPC -> text; BACKOFF [1,3,6,10,15,30] min (:162)\",\"GAPS: no discovery cause table from real logs, no GUI --capture of the countdown block, no executor report (seat died)\"],\"fresh_accepted\":false,\"kind\":\"historical\",\"op_id\":\"01M7Z0WSG4D6HJ4X72W6TM9F4K\",\"previous_status\":\"claimed\",\"reason\":\"Executor seat 01M7YES9 exited after landing the harness side and committing the term side; Oracle ran test-boundaries, test-formal and make land.\"}]"
    role = json"\"executor\""
