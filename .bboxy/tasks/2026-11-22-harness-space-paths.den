          },
          {
            "criterion": "999-model exact-source formal receipt",
            "reference": "/private/var/folders/zd/mv_mr2d92p5_1r8yghzbs5vw0000gn/T/bboxy-space-paths-evidence-t4hbg8ay/term-formal-evidence.log"
          }
        ]
      }
    }
    ```
    """

