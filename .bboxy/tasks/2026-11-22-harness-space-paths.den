        "exit_code": 0,
        "evidence": [
          {
            "criterion": "Brief nextest command passed 23 tests",
            "reference": "/private/var/folders/zd/mv_mr2d92p5_1r8yghzbs5vw0000gn/T/bboxy-space-paths-evidence-t4hbg8ay/brief.log"
          },
          {
            "criterion": "Dream and ACP fixtures passed with test-fixtures enabled in a checkout with spaces",
            "reference": "/private/var/folders/zd/mv_mr2d92p5_1r8yghzbs5vw0000gn/T/bboxy-space-paths-evidence-t4hbg8ay/focused.log"
          },
