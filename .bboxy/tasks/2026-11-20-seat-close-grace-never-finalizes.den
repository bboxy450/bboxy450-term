    reconciliation = json"[{\"by\":\"seat:01M7VC8EK2C7DQXBNCE9V0J0MH\",\"disposition\":\"implemented\",\"evidence\":[\"origin/main 4130634ea Orphan close finalizes a seat that exited before its window close (crates/bbt-mux/src/logic.rs close_control_orphan accepts ClosedGrace)\",\"cargo nextest run -p bboxy450-term-mux --test it -E test(mcp_orphan_close_checks_supervisor_absence): 1 passed (new ClosedGrace case)\",\"Not done: automatic finalization on the mux clock without a repeat seat_close; full make land not run (operator: minimal tests)\"],\"fresh_accepted\":false,\"kind\":\"historical\",\"op_id\":\"01M7XZG0T3XJGGENY4Y9H6B920\",\"previous_status\":\"open\",\"reason\":\"Root cause: a window close of a seat whose process had already exited waits for an exit receipt that never comes. Fixed in the supervisor-checked orphan close; a repeat seat_close finalizes it. Operator asked for a quick land with minimal tests.\"}]"
    status = Done
    swarm = json"\"01M7P04CW1T6KY8CMSS6DQM12Q\""
