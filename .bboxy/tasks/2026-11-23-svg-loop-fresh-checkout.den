    delegated_by = json"\"seat:01M85BW3PMN3QBFPPMWBS866RA\""
    id = json"\"01M84KKWJAM54JB3RQTW8H09D3\""
    number = json"1794292861627810"
    role = json"\"executor\""
    status = Claimed
    swarm = json"\"01M7P04CW1T6KY8CMSS6DQM12Q\""
    updated = json"\"2026-11-24T01:02:55.404Z\""
