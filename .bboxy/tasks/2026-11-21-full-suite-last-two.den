            "reference": "/Users/feral/mydev/bbx-gate-repairs/target/suite-handoff/fixed-proto.log"
          },
          {
            "criterion": "ACP token and round stop reasons and durable causes pass",
            "reference": "/Users/feral/mydev/bbx-gate-repairs/target/suite-handoff/fixed-acp.log"
          },
          {
