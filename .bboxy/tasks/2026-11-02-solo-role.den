module tasks.`2026-11-02-solo-role`

task SoloRole {
  title "solo role: one seat that plans, builds, verifies and lands alone"
  verify $ cargo test -p bboxy450-term-mux --lib adapters; cargo test -p bboxy450-term-proto
  brief """
    # solo role

    Operator request: a lone harness that is oracle, architect and executor at once, with full permissions.

    - Built-in role `solo`, class Oracle (`crates/bbt-proto/src/gui/roles.rs`), available for every harness, mark ♚ in the oracle color.
    - Every launch already bypasses permissions (Claude `--dangerously-skip-permissions`, Codex `--yolo`), so no extra grant is needed.
    - Task assignment accepts `solo` like `oracle` (`crates/bbt-mux/src/mcp/work_items.rs` `validate_task_role`).
    - Prompt: own the whole task, do not delegate unless asked, report files, commands and results.
    """

  managed {
    created = json"\"2026-11-02T17:30:00Z\""
    id = json"\"01M6EN1DVZES3PW33N1W4YYVD2\""
    number = json"5185"
    role = json"\"executor\""
    status = Done
    updated = json"\"2026-11-02T17:30:00Z\""
    body_tail = json"\"\\n\""
  }
}
