            "reference": "/tmp/bboxy-chart-runtime-evidence-0svs12fy/chart-recheck.log:23,252–253"
          },
          {
            "criterion": "Historical image pins and media-type rejection",
            "reference": "/tmp/bboxy-chart-runtime-evidence-0svs12fy/chart-recheck.log:239 and crates/bbt-mux/tests/mcp/python_execution.rs:585"
          },
          {
            "criterion": "Canvas image bounds and preserved export pins",
            "reference": "/tmp/bboxy-chart-runtime-evidence-0svs12fy/chart-recheck.log:185,255–263 and crates/bbt-mux/src/mcp/canvas/render.rs:150"
          },
          {
