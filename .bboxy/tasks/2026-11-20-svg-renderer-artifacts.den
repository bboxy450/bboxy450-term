            "reference": "target/svg-handoff/phase-b-link-formal.log; receipt 31ef3529a8d6eca5f733e5fd661fae8fde39ef0f8aba72a84562a0c367dabddc"
          },
          {
            "criterion": "Signed landing and remote main",
            "reference": "target/svg-handoff/phase-b-link-land.log; target/svg-handoff/phase-b-link-remote.log"
          }
