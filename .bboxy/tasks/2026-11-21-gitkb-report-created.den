    verify_result = json"{\"command\":\"cargo nextest run -p bboxy450-term-mux -E 'test(report) | test(accept)' && cargo nextest run --manifest-path plugins/gitkb/Cargo.toml\",\"evidence\":[{\"criterion\":\"Private GitKB linked report acceptance and provider-owned timestamps\",\"reference\":\"/Users/feral/mydev/bbx-gitkb/target/gitkb-handoff/fixed-source.log\"},{\"criterion\":\"Broken control reproduces the #98 refusal\",\"reference\":\"/Users/feral/mydev/bbx-gitkb/target/gitkb-handoff/broken-final.log\"},{\"criterion\":\"Exact Nextest verification\",\"reference\":\"/Users/feral/mydev/bbx-gitkb/target/gitkb-handoff/verify.log\"},{\"criterion\":\"Formal verification on the landed source\",\"reference\":\"/Users/feral/mydev/bbx-gitkb/target/gitkb-handoff/formal.log\"},{\"criterion\":\"Canonical landing\",\"reference\":\"/Users/feral/mydev/bbx-gitkb/target/gitkb-handoff/land.log\"},{\"criterion\":\"GitHub issue closed with landed SHA\",\"reference\":\"https://github.com/bboxy450/bboxy450-term/issues/98#issuecomment-7068508119\"}],\"exit_code\":0}"
