module tasks.`2026-11-22-kb-index-external-adds`

task KbIndexExternalAdds {
  title "KB index misses records added by git pull while running"
  verify $ cargo nextest run -p bboxy450-term-mux -E 'test(index) | test(knowledge)'
  paths "crates/bbt-mux", "crates/bboxy450-term-data_source-bboxy", "verification", "Cargo.lock"
  brief """
    Our stand: subtract before you add; report what you removed. ROLE: EXECUTOR.

    ## Gap (Oracle, observed 2026-11-22)
    After `git pull --rebase` fast-forwarded the shared KB checkout by 59 commits, records that arrived that way are on disk but not in the knowledge index: `knowledge_fetch specs/python-charts` and `specs/svg-renderer` return `not_found` (files present, `den.check` sound, `managed {}` blocks present), while `specs/canvas` (modified, previously indexed) resolves. `knowledge_status` reports root revision 0, 28985 records.

    ## Do
    Find why externally added files (git pull, checkout) are not indexed while running: watcher scope, create vs modify events, a startup-only scan, or a refusal. Make externally added and removed records reach the index without an app restart, with a process witness that adds a record through `git` while the host runs and fetches it. Name what you removed.

    ## Land
    Long commands detached. `make land`. Report at reports/2026-11-22-kb-index-external-adds.den, then `task_report`.
    """

  managed {
    authorship = json"{\"kind\":\"seat\",\"process_generation\":\"1\",\"public_key\":\"+Z+SffD6ma7+9tH7HcO8nu+L88bfZ9A4Xu1v6WL7C48=\",\"signer\":\"seat:01M8288EHSV7SQ289RE0J1SK0S\"}"
    created = json"\"2026-11-22T18:40:45.262Z\""
    created_by = json"\"seat:01M8288EHSV7SQ289RE0J1SK0S\""
    delegated_by = json"\"seat:01M8288EHSV7SQ289RE0J1SK0S\""
    id = json"\"01M828YTHGX82AKMA49DBF11C7\""
