        "evidence": [
          {
            "criterion": "Before capture and negative glyph control",
            "reference": "/Users/feral/mydev/bboxy450-term-mobile/target/glyph-handoff/android-answered-before.png"
          },
          {
            "criterion": "Post-push answer, surface recreation, bold i ink and proportional spacing",
            "reference": "/Users/feral/mydev/bboxy450-term-mobile/target/glyph-handoff/android-answered-after.png"
          },
          {
            "criterion": "Exact verification command exit and emitted pixel measurements",
            "reference": "/Users/feral/mydev/bboxy450-term-mobile/target/glyph-handoff/android-after.log"
          },
          {
            "criterion": "Term landing, signed commit and formal receipt",
            "reference": "/Users/feral/mydev/bboxy450-term-mobile/target/glyph-handoff/term-land.log"
          },
          {
